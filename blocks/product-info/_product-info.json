{
  "definitions": [
    {
      "title": "Product Info (PDP)",
      "id": "product-info",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Product Info",
              "model": "product-info"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "product-info",
      "fields": [
        { "component": "reference", "valueType": "string", "name": "images", "label": "Gallery images", "multi": true },
        { "component": "text", "valueType": "string", "name": "productName", "label": "Product name", "required": true },
        { "component": "text", "valueType": "string", "name": "sku", "label": "SKU (analytics productId)", "required": true },
        { "component": "number", "valueType": "number", "name": "price", "label": "Price (USD)" },
        { "component": "number", "valueType": "number", "name": "compareAtPrice", "label": "Compare-at price" },
        { "component": "text", "valueType": "string", "name": "brand", "label": "Brand" },
        {
          "component": "select",
          "valueType": "string",
          "name": "category",
          "label": "Category",
          "options": [
            { "name": "Electronics", "value": "electronics" },
            { "name": "Fashion", "value": "fashion" },
            { "name": "Home Appliances", "value": "home-appliances" }
          ]
        },
        { "component": "number", "valueType": "number", "name": "rating", "label": "Rating (0-5)" },
        { "component": "number", "valueType": "number", "name": "reviewCount", "label": "Review count" },
        { "component": "richtext", "valueType": "string", "name": "description", "label": "Description" },
        { "component": "text", "valueType": "string", "name": "options", "label": "Colour options (comma separated)" }
      ]
    }
  ],
  "filters": []
}
