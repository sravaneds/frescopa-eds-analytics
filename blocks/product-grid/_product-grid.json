{
  "definitions": [
    {
      "title": "Product Grid",
      "id": "product-grid",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Product Grid",
              "model": "product-grid",
              "filter": "product-grid"
            }
          }
        }
      }
    },
    {
      "title": "Product",
      "id": "product-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Product",
              "model": "product-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "product-grid",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Options",
          "valueType": "string",
          "options": [
            { "name": "Show filters, sort and search", "value": "filters" }
          ]
        }
      ]
    },
    {
      "id": "product-item",
      "fields": [
        { "component": "reference", "valueType": "string", "name": "image", "label": "Image", "multi": false },
        { "component": "text", "valueType": "string", "name": "imageAlt", "label": "Image alt text", "value": "" },
        { "component": "text", "valueType": "string", "name": "productName", "label": "Product name", "value": "", "required": true },
        { "component": "text", "valueType": "string", "name": "sku", "label": "SKU / product ID (analytics productId)", "value": "", "required": true },
        { "component": "number", "valueType": "number", "name": "price", "label": "Price (USD)" },
        { "component": "number", "valueType": "number", "name": "compareAtPrice", "label": "Compare-at price (shows sale)" },
        {
          "component": "select",
          "valueType": "string",
          "name": "category",
          "label": "Category",
          "options": [
            { "name": "Electronics", "value": "electronics" },
            { "name": "Fashion", "value": "fashion" },
            { "name": "Home Appliances", "value": "home-appliances" }
          ]
        },
        { "component": "text", "valueType": "string", "name": "brand", "label": "Brand", "value": "" },
        { "component": "number", "valueType": "number", "name": "rating", "label": "Rating (0-5)" },
        { "component": "text", "valueType": "string", "name": "badge", "label": "Badge (New, Sale, Best Seller)", "value": "" },
        { "component": "aem-content", "valueType": "string", "name": "link", "label": "Product page" }
      ]
    }
  ],
  "filters": [
    {
      "id": "product-grid",
      "components": [
        "product-item"
      ]
    }
  ]
